#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
backend_dir="$repo_root/backend"
frontend_dir="$repo_root/frontend"

# Keep agent and sandboxed runs away from a developer's global uv cache while
# preserving an explicitly configured CI or local cache.
export UV_CACHE_DIR="${UV_CACHE_DIR:-${TMPDIR:-/tmp}/bioimageflow-platform-uv-cache}"

# shellcheck source=ci/test_versions.env
source "$repo_root/scripts/ci/test_versions.env"

usage() {
  cat <<'EOF'
Usage: scripts/test <command> [arguments]

Coding-loop commands:
  focus backend [PYTEST_ARGS...]  Run an exact backend selection.
  focus unit [VITEST_ARGS...]     Run an exact frontend unit selection.
  focus related FILE...           Run Vitest tests related to source files.
  focus e2e [PLAYWRIGHT_ARGS...]  Run an exact browser selection; defaults to Chromium.
  quick                            Run fast, repository-owned checks in parallel.

Completion commands:
  check backend                    Run backend lint, deterministic tests, and logging certification.
  check frontend                   Run frontend lint, type-checking, units, and production build.
  check docs                       Build documentation with warnings treated as failures.
  check browser-smoke              Run critical Chromium end-to-end tests.
  check cross-browser-smoke        Run critical Chromium and Firefox tests in parallel.
  check browser                    Run all Chromium end-to-end tests.
  check browser-firefox            Run all Firefox end-to-end tests.
  check browser-all                Run all Chromium and Firefox tests in parallel.
  check app                        Run backend/frontend checks and critical Chromium tests.
  check all                        Run backend/frontend checks and all Chromium tests.
  check                            Alias for check all.
  full                             Run coverage, all browsers, and external certification.
  certification                    Certify the pinned published common-tools package only.

Examples:
  scripts/test focus backend tests/test_services/test_dataset_store.py
  scripts/test focus backend tests/test_services/test_dataset_store.py::test_name
  scripts/test focus backend -k 'dataset and delete'
  scripts/test focus unit src/stores/__tests__/workflow.test.ts
  scripts/test focus unit src/stores/__tests__/workflow.test.ts -t 'deletes workflow'
  scripts/test focus related frontend/src/stores/workflow.ts
  scripts/test focus e2e tests/e2e/execution.spec.ts:111
  scripts/test focus e2e --project=firefox tests/e2e/hot-reload.spec.ts
  scripts/test focus e2e --grep 'executes a source tool'

The full lane installs bioimageflow-common-tools from the package index into a
fresh temporary store. It requires network access and never silently omits the
external tests. CI and local runs use the published dependency versions locked
in backend/uv.lock.
EOF
}

script_started_at=$SECONDS
command_label="$*"

report_total_time() {
  local status=$?
  trap - EXIT
  printf '\nTOTAL: scripts/test %s (%ss, exit %s)\n' \
    "${command_label:-help}" "$((SECONDS - script_started_at))" "$status"
  exit "$status"
}
trap report_total_time EXIT

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$1" >&2
    return 1
  fi
}

phase() {
  local label="$1"
  shift
  local started_at=$SECONDS
  local status=0
  printf '\n==> %s\n' "$label"
  if "$@"; then
    status=0
  else
    status=$?
  fi
  if (( status == 0 )); then
    printf '<== PASS: %s (%ss)\n' "$label" "$((SECONDS - started_at))"
  else
    printf '<== FAIL: %s (%ss, exit %s)\n' \
      "$label" "$((SECONDS - started_at))" "$status" >&2
  fi
  return "$status"
}

run_parallel() {
  local -a names=()
  local -a pids=()
  local name
  local pid
  local status=0
  local index

  for name in "$@"; do
    names+=("$name")
    ("$name") &
    pids+=("$!")
  done

  for index in "${!pids[@]}"; do
    pid="${pids[$index]}"
    if wait "$pid"; then
      printf '\nPASS: %s\n' "${names[$index]}"
    else
      printf '\nFAIL: %s\n' "${names[$index]}" >&2
      status=1
    fi
  done

  return "$status"
}

allocate_port() {
  local port
  if ! port="$("$backend_dir/.venv/bin/python" -c \
    'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()' \
    2>/dev/null)"; then
    printf 'Could not allocate a local E2E port. Grant local-server access or set BIOIMAGEFLOW_E2E_BACKEND_PORT and BIOIMAGEFLOW_E2E_FRONTEND_PORT.\n' >&2
    return 1
  fi
  printf '%s\n' "$port"
}

run_e2e() (
  if [[ "${BIOIMAGEFLOW_TEST_DRY_RUN:-0}" == "1" ]]; then
    printf 'E2E dry run:'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi

  require_command bun
  if [[ ! -x "$backend_dir/.venv/bin/python" ]]; then
    printf 'Backend environment missing: run cd backend && uv sync --group dev --frozen\n' >&2
    return 1
  fi

  local managed_root=0
  local e2e_root="${BIOIMAGEFLOW_E2E_ROOT:-}"
  if [[ -z "$e2e_root" ]]; then
    e2e_root="$(mktemp -d "${TMPDIR:-/tmp}/bioimageflow-platform-e2e.XXXXXX")"
    managed_root=1
  fi

  cleanup_e2e_root() {
    if (( managed_root )); then
      rm -rf -- "$e2e_root"
    fi
  }
  trap cleanup_e2e_root EXIT

  export BIOIMAGEFLOW_E2E_ROOT="$e2e_root"
  if [[ -z "${BIOIMAGEFLOW_E2E_BACKEND_PORT:-}" ]]; then
    BIOIMAGEFLOW_E2E_BACKEND_PORT="$(allocate_port)"
  fi
  if [[ -z "${BIOIMAGEFLOW_E2E_FRONTEND_PORT:-}" ]]; then
    BIOIMAGEFLOW_E2E_FRONTEND_PORT="$(allocate_port)"
  fi
  export BIOIMAGEFLOW_E2E_BACKEND_PORT BIOIMAGEFLOW_E2E_FRONTEND_PORT
  while [[ "$BIOIMAGEFLOW_E2E_FRONTEND_PORT" == "$BIOIMAGEFLOW_E2E_BACKEND_PORT" ]]; do
    export BIOIMAGEFLOW_E2E_FRONTEND_PORT="$(allocate_port)"
  done

  cd "$frontend_dir"
  bun run test:e2e -- "$@"
)

playwright_has_option() {
  local option="$1"
  shift
  local argument
  for argument in "$@"; do
    if [[ "$argument" == "$option" || "$argument" == "$option="* ]]; then
      return 0
    fi
  done
  return 1
}

run_e2e_fail_fast() {
  local -a arguments=("$@")
  if ! playwright_has_option --max-failures "${arguments[@]}"; then
    arguments+=("--max-failures=${BIOIMAGEFLOW_E2E_MAX_FAILURES:-1}")
  fi
  run_e2e "${arguments[@]}"
}

run_focused_e2e() {
  local -a arguments=("$@")
  if ! playwright_has_option --project "${arguments[@]}"; then
    arguments=("--project=chromium" "${arguments[@]}")
  fi
  run_e2e_fail_fast "${arguments[@]}"
}

run_browser_project() (
  local project="$1"
  shift
  export BIOIMAGEFLOW_E2E_ARTIFACT_SUFFIX="$project"
  run_e2e_fail_fast "--project=$project" "$@"
)

run_isolated_browser_project() (
  unset BIOIMAGEFLOW_E2E_ROOT
  unset BIOIMAGEFLOW_E2E_BACKEND_PORT
  unset BIOIMAGEFLOW_E2E_FRONTEND_PORT
  run_browser_project "$@"
)

chromium_smoke_e2e() {
  phase 'Critical Chromium end-to-end tests' \
    run_browser_project chromium --grep @critical
}

isolated_chromium_smoke_e2e() {
  phase 'Critical Chromium end-to-end tests' \
    run_isolated_browser_project chromium --grep @critical
}

firefox_smoke_e2e() {
  phase 'Critical Firefox end-to-end tests' \
    run_browser_project firefox --grep @critical
}

isolated_firefox_smoke_e2e() {
  phase 'Critical Firefox end-to-end tests' \
    run_isolated_browser_project firefox --grep @critical
}

chromium_full_e2e() {
  phase 'Chromium end-to-end tests' run_browser_project chromium
}

isolated_chromium_full_e2e() {
  phase 'Chromium end-to-end tests' run_isolated_browser_project chromium
}

firefox_full_e2e() {
  phase 'Firefox end-to-end tests' run_browser_project firefox
}

isolated_firefox_full_e2e() {
  phase 'Firefox end-to-end tests' run_isolated_browser_project firefox
}

backend_lint() {
  phase 'Backend lint' bash -c 'cd "$1" && uv run --frozen ruff check .' _ "$backend_dir"
}

backend_quick() {
  phase 'Backend fast tests' bash -c \
    'cd "$1" && uv run --frozen pytest -m "not integration and not serial and not slow and not external" --durations=10' \
    _ "$backend_dir"
}

backend_deterministic() {
  phase 'Backend deterministic tests' bash -c \
    'cd "$1" && uv run --frozen pytest -m "not external" --durations=20' \
    _ "$backend_dir"
}

backend_full_coverage() (
  export COVERAGE_FILE="$backend_dir/.pytest_cache/.coverage"
  cleanup_coverage_data() {
    rm -f -- "$COVERAGE_FILE"
  }
  trap cleanup_coverage_data EXIT
  phase 'Backend full tests with branch coverage' bash -c \
    'cd "$1" && uv run --frozen pytest --run-external --cov=bioimageflow_server --cov-branch --cov-report=term-missing --cov-report=xml:.pytest_cache/coverage.xml --cov-report=html:.pytest_cache/htmlcov --durations=20' \
    _ "$backend_dir"
)

backend_logging_order() {
  phase 'Backend logging-order certification' bash -c '
    cd "$1" && uv run --frozen pytest \
      tests/test_logging_config.py \
      tests/test_ws/test_handler.py::test_publish_without_loop_drops_silently \
      tests/test_ws/test_handler.py::test_publish_logs_future_exceptions \
      tests/test_ws/test_logging_bridge.py::test_attach_to_bioimageflow_logger \
      -q
  ' _ "$backend_dir"
}

frontend_lint() {
  phase 'Frontend lint' bash -c 'cd "$1" && bun run lint' _ "$frontend_dir"
}

frontend_typecheck() {
  phase 'Frontend type-check' bash -c 'cd "$1" && bun run type-check' _ "$frontend_dir"
}

frontend_quick() {
  phase 'Frontend fast Node tests' bash -c \
    'cd "$1" && bun run test:unit -- --project=node' _ "$frontend_dir"
}

frontend_all_units() {
  phase 'Frontend unit tests' bash -c 'cd "$1" && bun run test:unit' _ "$frontend_dir"
}

frontend_full_coverage() {
  phase 'Frontend unit tests with branch coverage' bash -c \
    'cd "$1" && bun run test:unit -- --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reportsDirectory=test-results/coverage' \
    _ "$frontend_dir"
}

frontend_build() {
  phase 'Frontend production build' bash -c 'cd "$1" && bun run build' _ "$frontend_dir"
}

quick_lane() {
  require_command uv
  require_command bun
  run_parallel backend_lint backend_quick frontend_lint frontend_typecheck frontend_quick
  printf '\nQuick lane passed. External, integration, serial, slow, browser, and coverage phases were intentionally not run.\n'
}

check_lane() {
  require_command uv
  require_command bun
  run_parallel backend_lint backend_deterministic frontend_lint frontend_typecheck frontend_all_units frontend_build
  backend_logging_order
  chromium_full_e2e
  printf '\nCheck lane passed. External package certification and Firefox were intentionally not run.\n'
}

backend_check_lane() {
  require_command uv
  run_parallel backend_lint backend_deterministic
  backend_logging_order
  printf '\nBackend check passed. External package certification was intentionally not run.\n'
}

frontend_check_lane() {
  require_command bun
  run_parallel frontend_lint frontend_typecheck frontend_all_units frontend_build
  printf '\nFrontend check passed. Browser tests were intentionally not run.\n'
}

docs_check_lane() {
  local sphinx_build="$repo_root/.venv/bin/sphinx-build"
  if [[ ! -x "$sphinx_build" ]]; then
    printf 'Documentation environment missing: run uv venv && uv pip install -r docs/requirements.txt\n' >&2
    return 1
  fi
  phase 'Documentation' "$sphinx_build" -W --keep-going "$repo_root/docs" "$repo_root/docs/_build/html"
  printf '\nDocumentation check passed.\n'
}

browser_smoke_check_lane() {
  chromium_smoke_e2e
  printf '\nCritical Chromium smoke check passed.\n'
}

cross_browser_smoke_check_lane() {
  run_parallel isolated_chromium_smoke_e2e isolated_firefox_smoke_e2e
  printf '\nCritical Chromium and Firefox smoke checks passed.\n'
}

browser_check_lane() {
  chromium_full_e2e
  printf '\nChromium check passed.\n'
}

firefox_check_lane() {
  firefox_full_e2e
  printf '\nFirefox check passed.\n'
}

all_browsers_check_lane() {
  run_parallel isolated_chromium_full_e2e isolated_firefox_full_e2e
  printf '\nChromium and Firefox checks passed.\n'
}

app_check_lane() {
  require_command uv
  require_command bun
  run_parallel backend_lint backend_deterministic frontend_lint frontend_typecheck frontend_all_units frontend_build
  backend_logging_order
  chromium_smoke_e2e
  printf '\nApplication check passed. External package certification and non-critical browser tests were intentionally not run.\n'
}

scoped_check_lane() {
  local scope="${1:-all}"
  case "$scope" in
    backend)
      backend_check_lane
      ;;
    frontend)
      frontend_check_lane
      ;;
    docs)
      docs_check_lane
      ;;
    browser-smoke)
      browser_smoke_check_lane
      ;;
    cross-browser-smoke)
      cross_browser_smoke_check_lane
      ;;
    browser)
      browser_check_lane
      ;;
    browser-firefox)
      firefox_check_lane
      ;;
    browser-all)
      all_browsers_check_lane
      ;;
    app)
      app_check_lane
      ;;
    all)
      check_lane
      ;;
    *)
      printf 'Unknown check scope: %s\n' "$scope" >&2
      return 2
      ;;
  esac
}

create_certification_store() {
  local certification_root="$1"
  export BIOIMAGEFLOW_TOOL_STORE="$certification_root/tool_packages"
  phase "Install bioimageflow-common-tools $BIOIMAGEFLOW_COMMON_TOOLS_VERSION" \
    bash "$repo_root/scripts/ci/install_common_tools_from_index.sh"
}

backend_import_preflight() {
  phase 'Backend source import preflight' \
    "$backend_dir/.venv/bin/python" -c 'import bioimageflow_server.app'
}

certification_lane() (
  require_command uv
  if [[ ! -x "$backend_dir/.venv/bin/python" ]]; then
    printf 'Backend environment missing: run cd backend && uv sync --group dev --frozen\n' >&2
    return 1
  fi

  backend_import_preflight

  local certification_root
  certification_root="$(mktemp -d "${TMPDIR:-/tmp}/bioimageflow-common-tools-certification.XXXXXX")"
  trap 'rm -rf -- "$certification_root"' EXIT
  create_certification_store "$certification_root"
  phase 'External common-tools tests' bash -c \
    'cd "$1" && uv run --frozen pytest --run-external -m external --durations=10' \
    _ "$backend_dir"
  printf '\nExternal certification passed with bioimageflow-common-tools %s.\n' \
    "$BIOIMAGEFLOW_COMMON_TOOLS_VERSION"
)

full_lane() (
  require_command uv
  require_command bun
  if [[ ! -x "$backend_dir/.venv/bin/python" ]]; then
    printf 'Backend environment missing: run cd backend && uv sync --group dev --frozen\n' >&2
    return 1
  fi

  backend_import_preflight

  local certification_root
  certification_root="$(mktemp -d "${TMPDIR:-/tmp}/bioimageflow-common-tools-certification.XXXXXX")"
  trap 'rm -rf -- "$certification_root"' EXIT
  create_certification_store "$certification_root"

  run_parallel backend_lint backend_full_coverage frontend_lint frontend_typecheck frontend_full_coverage frontend_build
  backend_logging_order
  run_parallel isolated_chromium_full_e2e isolated_firefox_full_e2e
  printf '\nFull lane passed: repository tests, external certification, branch coverage, production build, Chromium, and Firefox all completed.\n'
  printf 'Coverage artifacts: backend/.pytest_cache/{coverage.xml,htmlcov/} and frontend/test-results/coverage/.\n'
)

focus_lane() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    printf 'focus requires one of: backend, unit, related, e2e\n' >&2
    return 2
  fi
  shift

  case "$target" in
    backend)
      require_command uv
      cd "$backend_dir"
      uv run --frozen pytest "$@"
      ;;
    unit)
      require_command bun
      cd "$frontend_dir"
      bun run test:unit -- "$@"
      ;;
    related)
      require_command bun
      if (( $# == 0 )); then
        printf 'focus related requires at least one source file\n' >&2
        return 2
      fi
      local -a related_files=()
      local source_file
      for source_file in "$@"; do
        related_files+=("${source_file#frontend/}")
      done
      cd "$frontend_dir"
      bun run vitest related "${related_files[@]}" --run
      ;;
    e2e)
      run_focused_e2e "$@"
      ;;
    *)
      printf 'Unknown focus target: %s\n' "$target" >&2
      return 2
      ;;
  esac
}

command="${1:-help}"
if (( $# > 0 )); then
  shift
fi

case "$command" in
  help|-h|--help)
    usage
    ;;
  focus)
    focus_lane "$@"
    ;;
  quick)
    if (( $# > 0 )); then
      printf 'quick does not accept selectors; use scripts/test focus instead\n' >&2
      exit 2
    fi
    quick_lane
    ;;
  check)
    if (( $# > 1 )); then
      printf 'check accepts at most one scope\n' >&2
      exit 2
    fi
    scoped_check_lane "${1:-all}"
    ;;
  full)
    if (( $# > 0 )); then
      printf 'full does not accept selectors; use scripts/test focus instead\n' >&2
      exit 2
    fi
    full_lane
    ;;
  certification)
    if (( $# > 0 )); then
      printf 'certification does not accept selectors\n' >&2
      exit 2
    fi
    certification_lane
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
