#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
backend_dir="$repo_root/backend"
assets_dir="$backend_dir/src/bioimageflow_server/assets"
source_svg="${1:-$repo_root/logo/microscope.svg}"

# A precomposed macOS icon uses an 824 px visual tile centered on the
# 1024 px icon canvas, leaving 100 px of transparent margin on each side.
macos_canvas_size=1024
macos_artwork_size=824

export UV_CACHE_DIR="${UV_CACHE_DIR:-${TMPDIR:-/tmp}/bioimageflow-platform-uv-cache}"

usage() {
  cat <<'EOF'
Usage: scripts/generate_desktop_icons [SOURCE_SVG]

Generate the desktop application's platform-specific icons:

  app_icon.png   Linux, 512x512
  app_icon.ico   Windows, 16 through 256 px
  app_icon.icns  macOS, with 100 px transparent margins on a 1024 px canvas

The default source is logo/microscope.svg.
Requires rsvg-convert, ImageMagick's magick command, uv, and the backend's
locked Pillow dependency.
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$1" >&2
    return 1
  fi
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "$#" -gt 1 ]]; then
  usage >&2
  exit 2
fi

if [[ ! -f "$source_svg" ]]; then
  printf 'Source SVG not found: %s\n' "$source_svg" >&2
  exit 1
fi

require_command rsvg-convert
require_command magick
require_command uv

mkdir -p "$assets_dir"
temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/bioimageflow-desktop-icons.XXXXXX")"
trap 'rm -rf -- "$temporary_dir"' EXIT

full_master="$temporary_dir/app_icon_1024.png"
macos_master="$temporary_dir/app_icon_macos_1024.png"
linux_output="$temporary_dir/app_icon.png"
windows_output="$temporary_dir/app_icon.ico"
macos_output="$temporary_dir/app_icon.icns"

rsvg-convert \
  --width 512 \
  --height 512 \
  "$source_svg" \
  --output "$linux_output"

rsvg-convert \
  --width "$macos_canvas_size" \
  --height "$macos_canvas_size" \
  "$source_svg" \
  --output "$full_master"

magick \
  "$full_master" \
  -define icon:auto-resize=256,128,64,48,32,24,16 \
  "$windows_output"

magick \
  "$full_master" \
  -resize "${macos_artwork_size}x${macos_artwork_size}" \
  -gravity center \
  -background none \
  -extent "${macos_canvas_size}x${macos_canvas_size}" \
  "$macos_master"

uv run \
  --project "$backend_dir" \
  --frozen \
  python - \
  "$linux_output" \
  "$windows_output" \
  "$macos_master" \
  "$macos_output" <<'PY'
from pathlib import Path
import sys

from PIL import Image


linux_path = Path(sys.argv[1])
windows_path = Path(sys.argv[2])
macos_master_path = Path(sys.argv[3])
macos_path = Path(sys.argv[4])

macos_master = Image.open(macos_master_path).convert("RGBA")
if macos_master.size != (1024, 1024):
    raise SystemExit(f"Unexpected macOS master size: {macos_master.size}")
if macos_master.getchannel("A").getbbox() != (100, 100, 924, 924):
    raise SystemExit(
        "Unexpected macOS artwork bounds: "
        f"{macos_master.getchannel('A').getbbox()}"
    )
macos_master.save(macos_path, format="ICNS")

linux_icon = Image.open(linux_path)
if linux_icon.format != "PNG" or linux_icon.size != (512, 512):
    raise SystemExit(
        f"Unexpected Linux icon: format={linux_icon.format}, size={linux_icon.size}"
    )

windows_icon = Image.open(windows_path)
expected_windows_sizes = {
    (16, 16),
    (24, 24),
    (32, 32),
    (48, 48),
    (64, 64),
    (128, 128),
    (256, 256),
}
if windows_icon.format != "ICO" or windows_icon.info.get("sizes") != expected_windows_sizes:
    raise SystemExit(
        "Unexpected Windows icon: "
        f"format={windows_icon.format}, sizes={windows_icon.info.get('sizes')}"
    )

macos_icon = Image.open(macos_path).convert("RGBA")
if macos_icon.size != (1024, 1024):
    raise SystemExit(f"Unexpected macOS icon size: {macos_icon.size}")
if macos_icon.getchannel("A").getbbox() != (100, 100, 924, 924):
    raise SystemExit(
        f"Unexpected macOS icon bounds: {macos_icon.getchannel('A').getbbox()}"
    )
PY

cp "$linux_output" "$assets_dir/app_icon.png"
cp "$windows_output" "$assets_dir/app_icon.ico"
cp "$macos_output" "$assets_dir/app_icon.icns"

printf '%s\n' \
  "$assets_dir/app_icon.png" \
  "$assets_dir/app_icon.ico" \
  "$assets_dir/app_icon.icns"
