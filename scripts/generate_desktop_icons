#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
backend_dir="$repo_root/backend"
assets_dir="$backend_dir/src/bioimageflow_server/assets"
launcher_assets_dir="$backend_dir/packaging/launcher"
source_svg="${1:-$repo_root/logo/microscope.svg}"
launcher_source_icon="$launcher_assets_dir/icon_128x128.png"

# A precomposed macOS icon uses an 824 px visual tile centered on the
# 1024 px icon canvas, leaving 100 px of transparent margin on each side.
macos_canvas_size=1024
macos_artwork_size=824

export UV_CACHE_DIR="${UV_CACHE_DIR:-${TMPDIR:-/tmp}/bioimageflow-platform-uv-cache}"

usage() {
  cat <<'EOF'
Usage: scripts/generate_desktop_icons [SOURCE_SVG]

Generate the desktop application's platform-specific icons:

  assets/app_icon.png            Linux, 512x512
  assets/app_icon.ico            Windows, 16 through 256 px
  assets/app_icon.icns           macOS platform icon, inset on a 1024 px canvas
  packaging/launcher/app.icns    macOS launcher icon, inset on a 1024 px canvas

The platform icon defaults to logo/microscope.svg.
The macOS launcher icon is generated from the existing portable launcher PNG.
Requires rsvg-convert, ImageMagick's magick command, uv, and the backend's
locked Pillow dependency.
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$1" >&2
    return 1
  fi
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "$#" -gt 1 ]]; then
  usage >&2
  exit 2
fi

if [[ ! -f "$source_svg" ]]; then
  printf 'Source SVG not found: %s\n' "$source_svg" >&2
  exit 1
fi

if [[ ! -f "$launcher_source_icon" ]]; then
  printf 'Launcher icon not found: %s\n' "$launcher_source_icon" >&2
  exit 1
fi

require_command rsvg-convert
require_command magick
require_command uv

mkdir -p "$assets_dir" "$launcher_assets_dir"
temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/bioimageflow-desktop-icons.XXXXXX")"
trap 'rm -rf -- "$temporary_dir"' EXIT

full_master="$temporary_dir/app_icon_1024.png"
macos_master="$temporary_dir/app_icon_macos_1024.png"
launcher_macos_master="$temporary_dir/launcher_icon_macos_1024.png"
linux_output="$temporary_dir/app_icon.png"
windows_output="$temporary_dir/app_icon.ico"
macos_output="$temporary_dir/app_icon.icns"
launcher_macos_output="$temporary_dir/launcher_app.icns"

rsvg-convert \
  --width 512 \
  --height 512 \
  "$source_svg" \
  --output "$linux_output"

rsvg-convert \
  --width "$macos_canvas_size" \
  --height "$macos_canvas_size" \
  "$source_svg" \
  --output "$full_master"

magick \
  "$full_master" \
  -define icon:auto-resize=256,128,64,48,32,24,16 \
  "$windows_output"

magick \
  "$full_master" \
  -resize "${macos_artwork_size}x${macos_artwork_size}" \
  -gravity center \
  -background none \
  -extent "${macos_canvas_size}x${macos_canvas_size}" \
  "$macos_master"

magick \
  "$launcher_source_icon" \
  -resize "${macos_artwork_size}x${macos_artwork_size}" \
  -gravity center \
  -background none \
  -extent "${macos_canvas_size}x${macos_canvas_size}" \
  "$launcher_macos_master"

uv run \
  --project "$backend_dir" \
  --frozen \
  python - \
  "$linux_output" \
  "$windows_output" \
  "$macos_master" \
  "$macos_output" \
  "$launcher_macos_master" \
  "$launcher_macos_output" <<'PY'
from pathlib import Path
import sys

from PIL import Image


linux_path = Path(sys.argv[1])
windows_path = Path(sys.argv[2])
macos_master_path = Path(sys.argv[3])
macos_path = Path(sys.argv[4])
launcher_macos_master_path = Path(sys.argv[5])
launcher_macos_path = Path(sys.argv[6])


def write_macos_icon(master_path: Path, icon_path: Path, label: str) -> None:
    master = Image.open(master_path).convert("RGBA")
    if master.size != (1024, 1024):
        raise SystemExit(f"Unexpected {label} master size: {master.size}")
    if master.getchannel("A").getbbox() != (100, 100, 924, 924):
        raise SystemExit(
            f"Unexpected {label} artwork bounds: "
            f"{master.getchannel('A').getbbox()}"
        )
    master.save(icon_path, format="ICNS")


def validate_macos_icon(icon_path: Path, label: str) -> None:
    icon = Image.open(icon_path).convert("RGBA")
    if icon.size != (1024, 1024):
        raise SystemExit(f"Unexpected {label} icon size: {icon.size}")
    if icon.getchannel("A").getbbox() != (100, 100, 924, 924):
        raise SystemExit(
            f"Unexpected {label} icon bounds: {icon.getchannel('A').getbbox()}"
        )


write_macos_icon(macos_master_path, macos_path, "macOS platform")
write_macos_icon(
    launcher_macos_master_path,
    launcher_macos_path,
    "macOS launcher",
)

linux_icon = Image.open(linux_path)
if linux_icon.format != "PNG" or linux_icon.size != (512, 512):
    raise SystemExit(
        f"Unexpected Linux icon: format={linux_icon.format}, size={linux_icon.size}"
    )

windows_icon = Image.open(windows_path)
expected_windows_sizes = {
    (16, 16),
    (24, 24),
    (32, 32),
    (48, 48),
    (64, 64),
    (128, 128),
    (256, 256),
}
if (
    windows_icon.format != "ICO"
    or windows_icon.info.get("sizes") != expected_windows_sizes
):
    raise SystemExit(
        "Unexpected Windows icon: "
        f"format={windows_icon.format}, sizes={windows_icon.info.get('sizes')}"
    )

validate_macos_icon(macos_path, "macOS platform")
validate_macos_icon(launcher_macos_path, "macOS launcher")
PY

cp "$linux_output" "$assets_dir/app_icon.png"
cp "$windows_output" "$assets_dir/app_icon.ico"
cp "$macos_output" "$assets_dir/app_icon.icns"
cp "$launcher_macos_output" "$launcher_assets_dir/app.icns"

printf '%s\n' \
  "$assets_dir/app_icon.png" \
  "$assets_dir/app_icon.ico" \
  "$assets_dir/app_icon.icns" \
  "$launcher_assets_dir/app.icns"
