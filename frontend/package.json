{
  "name": "bioimageflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:unit:focus": "vitest run",
    "test:unit:changed": "vitest run --changed --passWithNoTests",
    "test:unit:quick": "vitest run --project=node",
    "test:unit:full": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:focus": "playwright test --project=chromium",
    "test:e2e:critical": "playwright test --project=chromium --grep @critical",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:all-browser": "playwright test --project=chromium --project=firefox",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "generate-types": "bash scripts/generate-types.sh"
  },
  "dependencies": {
    "@primevue/themes": "^4.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1",
    "@vue-flow/core": "^1.42",
    "axios": "^1.7",
    "dockview-core": "^4.3",
    "dockview-vue": "^4.3",
    "pinia": "^3.0",
    "primeicons": "^7.0",
    "primevue": "^4.3",
    "vue": "^3.5",
    "vue-router": "^4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.51",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^5.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/eslint-config-typescript": "^14.0",
    "@vue/test-utils": "^2.4",
    "@vue/tsconfig": "^0.7",
    "eslint": "^9.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.6",
    "typescript": "~5.8",
    "vite": "~6.2",
    "vitest": "^3.1",
    "vue-tsc": "~2.2"
  }
}
