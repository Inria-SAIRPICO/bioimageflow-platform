{
  "accepts_upstream": true,
  "categories": [
    "segmentation"
  ],
  "dataframe_output": true,
  "display_name": "Cellpose SAM",
  "documentation": "Segment cells or nuclei using the Cellpose algorithm. Produces a labeled mask image.",
  "dynamic_outputs": false,
  "inputs": {
    "cellprob_threshold": {
      "choices": null,
      "connectable": "not_by_default",
      "default": 0.0,
      "description": "Threshold on the network's cell-probability output (sigmoid input, typically in the range -6 to +6). Pixels above this threshold are used to run the flow dynamics and form ROIs. Decrease the threshold if Cellpose is not returning as many ROIs as expected; increase it if Cellpose is returning too many ROIs, particularly from dim areas.",
      "display_name": "Cell probability threshold",
      "group": null,
      "image_spec": null,
      "max": 6.0,
      "min": -6.0,
      "required": false,
      "step": 0.5,
      "type": "float"
    },
    "diameter": {
      "choices": null,
      "connectable": "not_by_default",
      "default": 0.0,
      "description": "Approximate cell diameter in pixels. Set to 0 for automatic estimation.",
      "display_name": "Cell diameter",
      "group": null,
      "image_spec": null,
      "max": 500.0,
      "min": 0.0,
      "required": false,
      "step": 0.5,
      "type": "float"
    },
    "flow_threshold": {
      "choices": null,
      "connectable": "not_by_default",
      "default": 0.4,
      "description": "Maximum allowed mean squared error between the flows recomputed from predicted ROIs and the flows predicted by the network. Increase this threshold if Cellpose is not returning as many ROIs as expected; decrease it if Cellpose is returning too many ill-shaped ROIs.",
      "display_name": "Flow threshold",
      "group": null,
      "image_spec": null,
      "max": 1.0,
      "min": 0.0,
      "required": false,
      "step": 0.05,
      "type": "float"
    },
    "input_image": {
      "choices": null,
      "connectable": "by_default",
      "default": null,
      "description": "Fluorescence or brightfield image to segment (2D intensity, optionally multi-channel).",
      "display_name": "Input image",
      "group": null,
      "image_spec": {
        "dtypes": [],
        "formats": [],
        "layouts": [
          "CYX",
          "YX"
        ],
        "semantics": [
          "intensity"
        ]
      },
      "max": null,
      "min": null,
      "required": true,
      "step": null,
      "type": "ImageFile"
    },
    "model_type": {
      "choices": null,
      "connectable": "not_by_default",
      "default": "cyto3",
      "description": "Cellpose pretrained model name (e.g. 'cyto3', 'nuclei').",
      "display_name": "Model",
      "group": null,
      "image_spec": null,
      "max": null,
      "min": null,
      "required": false,
      "step": null,
      "type": "str"
    }
  },
  "name": "CellposeSAM",
  "outputs": {
    "cell_count": {
      "default": null,
      "image_spec": null,
      "type": "int"
    },
    "mask": {
      "default": "{input_image.stem}_mask{ext}",
      "image_spec": {
        "dtypes": [],
        "formats": [],
        "layouts": [
          "YX"
        ],
        "semantics": [
          "label"
        ]
      },
      "type": "ImageFile"
    }
  },
  "package": "bioimageflow_common_tools",
  "package_version": "0.1.1",
  "tags": [
    "segmentation",
    "cellpose",
    "deep learning"
  ],
  "tool_type": "ProcessingTool"
}
