{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Frontend: dev",
            "type": "shell",
            "command": "bun",
            "args": [
                "run",
                "dev",
                "--",
                "--strictPort"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Local:.*http://localhost:5173/"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            }
        }
    ]
}
