{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Frontend: dev",
            "type": "shell",
            "command": "bun",
            "args": [
                "run",
                "dev",
                "--",
                "--strictPort",
                "--clearScreen=false"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "base": "$tsc-watch",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "ready in"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "focus": false
            }
        }
    ]
}
